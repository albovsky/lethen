#!/bin/bash

set -euo pipefail

cd "$(dirname "$0")/.."

source "dev/lib/lint-tools.sh"
require_lint_tools

bazel run //bazel/dev:buildifier.check
"$swiftformat" --lint --quiet --strict .
"$swiftlint" lint --quiet --strict
bash .github/scripts/check-release-isolation.sh
bash .github/scripts/check-release-isolation-test.sh
bash .github/scripts/action-scan-test.sh
