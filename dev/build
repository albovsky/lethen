#!/bin/bash

set -eo pipefail

cd "$(dirname "$0")/.."

usage="Usage: dev/build --arch arm64|release"
case "${1:-}" in
    -h|--help) echo "$usage"; exit 0 ;;
    --arch=*) set -- --arch "${1#--arch=}" "${@:2}" ;;
esac
if [[ $# -ne 2 || $1 != --arch ]]; then
    echo "$usage" >&2
    exit 1
fi
arch="$2"
case "$arch" in
    arm64 | release) ;;
    *)
        echo "Invalid architecture. Use --arch arm64 or --arch release" >&2
        exit 1
        ;;
esac

# Match the release workflow's optimization settings. Explicit cross-module
# optimization fails to link ArgumentParser with Xcode 27.
SWIFT_BUILD_FLAGS=(--product lethen --configuration release --disable-sandbox --scratch-path .build --arch arm64)

echo "Building for $arch (arm64)" >&2
swift build "${SWIFT_BUILD_FLAGS[@]}" >&2
EXECUTABLE="$(swift build "${SWIFT_BUILD_FLAGS[@]}" --show-bin-path)/lethen"

if [ "$arch" = "release" ]; then
    mkdir -p .release
    cp "$EXECUTABLE" .release/lethen
    strip -rSTX .release/lethen
    EXECUTABLE="$(realpath .release/lethen)"
fi

# Keep stdout machine-readable for callers such as the benchmark task.
printf '%s\n' "$EXECUTABLE"
