FROM swift:latest

RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN arch="$(uname -m)" && case "$arch" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; esac \
    && curl -Lo /usr/local/bin/bazelisk "https://github.com/bazelbuild/bazelisk/releases/latest/download/bazelisk-linux-$arch" \
    && chmod +x /usr/local/bin/bazelisk \
    && ln -s /usr/local/bin/bazelisk /usr/local/bin/bazel

WORKDIR /workspace
COPY . /workspace

ENV CC=clang
RUN bazel build //:periphery

COPY docker/entrypoint-bazel.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
